# ---- Runtime ----
# development | test | production
NODE_ENV=development
# Local standalone server port (unused on Vercel)
PORT=8000

# ---- CORS / cookies ----
# Exact origin of the web app. Cookies are issued for cross-site use in
# production (SameSite=None; Secure), so this must be an https:// origin there.
CLIENT_URL=http://localhost:3000

# ---- Database ----
# MongoDB connection string (e.g. MongoDB Atlas SRV URI)
MONGODB_URI=mongodb://localhost:27017/featurepulse

# ---- Auth ----
# Each secret must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting / login lockout (Upstash Redis) ----
# Required when NODE_ENV=production. Create a free database at https://upstash.com
# and copy the REST URL + token. Leave blank locally to disable rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
